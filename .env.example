# ===========================================================================
# ClaudeMark — Multi-AI Watermark & Provenance Forensics Toolkit
# Configuration Template (.env.example)
#
# Copy this file to `.env` for local development or Docker Compose.
# All parameters are optional — ClaudeMark operates out of the box with defaults.
# ===========================================================================

# ---------------------------------------------------------------------------
# HTTP Server & Web Dashboard
# ---------------------------------------------------------------------------
# Host address to bind the HTTP server (default: 127.0.0.1, use 0.0.0.0 for Docker)
CLAUDEMARK_HOST=127.0.0.1

# Port to listen on (default: 8765)
CLAUDEMARK_PORT=8765

# Optional API Bearer Token. When configured, API endpoints require:
# `Authorization: Bearer <your-secret-key>`
CLAUDEMARK_API_KEY=

# ---------------------------------------------------------------------------
# Default Watermark Research & Detection Parameters
# ---------------------------------------------------------------------------
# Default active detector algorithm (options: claude, kirchenbauer, synthid, generic)
CLAUDEMARK_DEFAULT_DETECTOR=claude

# Default statistical decision threshold (0.0 to 1.0, default: 0.65)
CLAUDEMARK_DETECTION_THRESHOLD=0.65

# ---------------------------------------------------------------------------
# Resource Limits & Safety Caps
# ---------------------------------------------------------------------------
# Maximum allowed payload size in bytes (default: 104857600 = 100 MB)
CLAUDEMARK_MAX_INPUT_BYTES=104857600
